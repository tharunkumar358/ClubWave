<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.campusflow.util.FlashUtil" %>
<%@ page import="com.campusflow.util.ViewHelper" %>
<%
    String flashType = (String) request.getAttribute(FlashUtil.REQ_FLASH_TYPE);
    String flashMessage = (String) request.getAttribute(FlashUtil.REQ_FLASH_MESSAGE);
    if (flashMessage != null && !flashMessage.trim().isEmpty()) {
        String icon = "bi-info-circle-fill";
        if ("success".equals(flashType)) {
            icon = "bi-check-circle-fill";
        } else if ("danger".equals(flashType)) {
            icon = "bi-exclamation-octagon-fill";
        } else if ("warning".equals(flashType)) {
            icon = "bi-exclamation-triangle-fill";
        }
        String alertClass = (flashType == null) ? "info" : flashType;
%>
<div class="alert alert-<%= ViewHelper.esc(alertClass) %> alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm cf-animate-in mb-4"
     role="alert">
    <i class="bi <%= icon %> fs-5 flex-shrink-0" aria-hidden="true"></i>
    <div><%= ViewHelper.esc(flashMessage) %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close notification"></button>
</div>
<% } %>
