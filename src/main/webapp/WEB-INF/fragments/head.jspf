<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.campusflow.util.ViewHelper" %>
<%@ page import="com.campusflow.util.AuthUtil" %>
<%
    String ctx = request.getContextPath();
    String pageTitle = (String) request.getAttribute("pageTitle");
    if (pageTitle == null || pageTitle.trim().isEmpty()) {
        pageTitle = "CampusClubSystem";
    } else {
        pageTitle = pageTitle + " — CampusClubSystem";
    }
%>
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= ViewHelper.esc(pageTitle) %></title>
    <script>
        (function () {
            try {
                var saved = localStorage.getItem("campusflow-theme");
                if (saved === "dark" || saved === "light") {
                    document.documentElement.setAttribute("data-bs-theme", saved);
                }
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="<%= ctx %>/assets/css/style.css">
</head>
<body>
