<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%
    String footerCtx = request.getContextPath();
%>
<footer class="mt-5 py-4 border-top bg-body-tertiary">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-body-secondary">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-mortarboard-fill text-primary"></i>
            <span class="fw-semibold text-body">CampusClubSystem</span>
            <span>&middot; College Club &amp; Event Administration Platform</span>
        </div>
        <div>
            <span>Prakruthi &bull; Spoorthi &bull; Kruthi &bull; Saheli &bull; Lakshya</span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
